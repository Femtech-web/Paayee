# Local Hardhat deployment.
# Local deploys Paayee-owned mock USDC/USDT and registers Paayee cUSDC/cUSDT as non-default app-managed assets.
# Leave these empty locally unless overriding Paayee's public USDC/USDT tokens.
PAAYEE_USDC_ADDRESS=
PAAYEE_USDT_ADDRESS=

# Klyde registration.
KLYDE_API_URL=http://localhost:4000
KLYDE_APP_ID=app_paayee_local
KLYDE_API_KEY=

# Optional: set this only if you want registration to also PATCH the Klyde app privacy config.
KLYDE_ADMIN_TOKEN=

# Optional registration/deployment overrides.
KLYDE_REGISTER_DRY_RUN=false
PAAYEE_CONTRACTS_NETWORK=localhost
PAAYEE_CONFIDENTIAL_ASSETS_FILE=

# Sepolia deployment.
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=
MNEMONIC=
SEPOLIA_PRIVATE_KEY=
SEPOLIA_USDC_ADDRESS=
SEPOLIA_USDT_ADDRESS=
