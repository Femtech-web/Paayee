# Server-only credentials for the `privy-session` Edge Function.
# Never prefix these with EXPO_PUBLIC_ and never place them in app/.env.

# Privy Dashboard > App settings > Basics > App ID.
# This is the same value as EXPO_PUBLIC_PRIVY_APP_ID in app/.env.
PRIVY_APP_ID=

# Privy Dashboard > App settings > Basics > App secret.
PRIVY_APP_SECRET=

# Supabase Dashboard > Project Settings > API > JWT Settings > JWT Secret.
PAAYEE_SUPABASE_JWT_SECRET=
