EXPO_PUBLIC_KLYDE_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_KLYDE_APP_ID=app_paayee_local
EXPO_PUBLIC_KLYDE_API_KEY=
EXPO_PUBLIC_KLYDE_ENVIRONMENT=local
EXPO_PUBLIC_KLYDE_MARKET=NG
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-after-supabase-start
EXPO_PUBLIC_ENABLE_REAL_INTEGRATIONS=false

# Zama mobile runtime for Paayee confidential assets.
EXPO_PUBLIC_ZAMA_MOBILE_RUNTIME_ENABLED=false
EXPO_PUBLIC_PAAYEE_AUTO_SHIELD_POLICY_ENABLED=true

# Local Hardhat cleartext FHEVM defaults.
EXPO_PUBLIC_ZAMA_LOCAL_RPC_URL=http://127.0.0.1:8545
EXPO_PUBLIC_ZAMA_LOCAL_EXECUTOR_ADDRESS=0xe3a9105a3a932253A70F126eb1E3b589C643dD24
EXPO_PUBLIC_ZAMA_LOCAL_RELAYER_URL=http://127.0.0.1:4000/v1/relayer/31337
# Receives private cUSDC/cUSDT when converting private stablecoin back to NGN.
# Local Hardhat default is the first dev account; Sepolia/Mainnet must use Klyde's configured settlement wallet.
EXPO_PUBLIC_KLYDE_PRIVACY_SETTLEMENT_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Sepolia/Mainnet values are intentionally left empty until we move out of local Hardhat.
EXPO_PUBLIC_ZAMA_SEPOLIA_RPC_URL=
EXPO_PUBLIC_ZAMA_SEPOLIA_RELAYER_URL=
EXPO_PUBLIC_ZAMA_MAINNET_RPC_URL=
EXPO_PUBLIC_ZAMA_MAINNET_RELAYER_URL=
