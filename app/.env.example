# Privy owns email/Google login and silently provisions the user's secure account.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Server-only Privy/Supabase credentials belong in supabase/functions/.env,
# never in this Expo environment file.
# Supabase is data-only. Configure Privy as a trusted third-party JWT issuer in Supabase.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-after-supabase-start
EXPO_PUBLIC_ENABLE_REAL_INTEGRATIONS=false
EXPO_PUBLIC_ENABLE_LEGACY_MONEY_RAIL=false
EXPO_PUBLIC_PAAYEE_API_URL=http://127.0.0.1:3000

# Zama mobile runtime for Paayee confidential assets.
EXPO_PUBLIC_ZAMA_MOBILE_RUNTIME_ENABLED=false
EXPO_PUBLIC_ZAMA_CHAIN_ID=31337
EXPO_PUBLIC_PAAYEE_CONVERSION_SETTLEMENT_ENABLED=false
EXPO_PUBLIC_PAAYEE_CUSDC_ADDRESS=
EXPO_PUBLIC_PAAYEE_CUSDT_ADDRESS=

# Current verified Sepolia deployment:
# EXPO_PUBLIC_ZAMA_CHAIN_ID=11155111
# EXPO_PUBLIC_PAAYEE_CUSDC_ADDRESS=0x9854C9845f02765000e33bFEe88b75B6539059eA
# EXPO_PUBLIC_PAAYEE_CUSDT_ADDRESS=0xfA8AC792e16D825729adDaDb13A900C26F76E1f4

# Local Hardhat cleartext FHEVM defaults.
EXPO_PUBLIC_ZAMA_LOCAL_RPC_URL=http://127.0.0.1:8545
EXPO_PUBLIC_ZAMA_LOCAL_EXECUTOR_ADDRESS=0xe3a9105a3a932253A70F126eb1E3b589C643dD24
EXPO_PUBLIC_ZAMA_LOCAL_RELAYER_URL=http://127.0.0.1:8545
# Receives private cUSDC/cUSDT when converting private stablecoin back to NGN.
# Local Hardhat default is the first dev account; production must use Paayee's settlement wallet.
EXPO_PUBLIC_PAAYEE_PRIVACY_SETTLEMENT_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Sepolia/Mainnet values are intentionally left empty until we move out of local Hardhat.
EXPO_PUBLIC_ZAMA_SEPOLIA_RPC_URL=
EXPO_PUBLIC_ZAMA_SEPOLIA_RELAYER_URL=
EXPO_PUBLIC_ZAMA_MAINNET_RPC_URL=
EXPO_PUBLIC_ZAMA_MAINNET_RELAYER_URL=
