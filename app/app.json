{
  "expo": {
    "name": "Paayee",
    "slug": "paayee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/paayee-app-icon.png",
    "scheme": "paayee",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/paayee-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/paayee-app-icon.png",
        "monochromeImage": "./assets/brand/paayee-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/paayee-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/paayee-splash-mark.png",
          "imageWidth": 84,
          "android": {
            "image": "./assets/brand/paayee-splash-mark.png",
            "imageWidth": 84
          },
          "ios": {
            "image": "./assets/brand/paayee-splash-mark.png",
            "imageWidth": 84
          }
        }
      ],
      "@react-native-vector-icons/feather"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
